        "maxAttempts": 3,
        "minMeanMetric": 3,
        "metrics": {
          "correctField": "game.stats.cleared",
          "metricField": "game.stats.cleared"
        }
      },
      "repeatAfterBlockScreens": [
        "Let's have another try.\nRemember: click the highlighted box to start a memory task. Each correct memory response shrinks that box by one step. Keep completing memory tasks until each highlighted box opens.\n"
      ],
      "manipulations": [
        "difficulty_practice",
        "condition_plan"
      ],
      "preBlockScreens": [
        {
          "html": "<div style='font-family: system-ui, -apple-system, sans-serif; font-size: 1.2rem; line-height: 1.45;'>Great work!<p><img src='assets/evander-bricks/sprite/boxy_cheer.png' alt='Boxy Cheering' style='max-height: 120px; height: 100%; width: auto;'/></p><p>Now, we will use the memory task to open some boxes! In the following trials, boxes will move slowly along the conveyor belts. Click the highlighted box to start a memory task. Correct memory responses shrink the highlighted box by one step; incorrect responses do not shrink it. Wider boxes require more correct memory tasks to open.</p><p>You can only open the box that Boxy has currently highlighted. Once you clear a box, Boxy will highlight another box for you to work on. Open as many boxes as possible before they are destroyed to maximise your coins!</p></div>"
        },
        "In the following block there will be one round: a full conveyor trial with multiple boxes."
      ],
      "afterBlockScreens": [
        {
          "html": "<div style='font-family: system-ui, -apple-system, sans-serif; font-size: 1.2rem; line-height: 1.45;'>Well done!<p>As part of this experiment, you will also be asked to respond to a flashing stimulus called the \"DRT\".<p>Whenever you see the border of the experiment window flash red, like this:<p><img src='assets/evander-bricks/drt_border.png' alt='DRT example' style='max-width: 480px; width: 100%; height: auto;'/><p>You should press the SPACEBAR as quickly as possible. This will happen repeatedly throughout the conveyor task.<p></div>"
        }
      ]
    },
    {
      "label": "DRTPractice",
      "phase": "practice",
      "trials": 1,
      "overrides": {
        "display": {
          "ui": {
            "showHUD": false
          },
          "character": {
            "enable": false
          }
