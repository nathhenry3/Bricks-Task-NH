        "bricks": {
          "initialBricks": {
            "type": "fixed",
            "value": 0
          },
          "forcedSet": [],
          "forcedSetPlan": {
            "enable": false,
            "count": 0
          },
          "maxBricksPerTrial": 0,
          "spawn": {
            "ratePerSec": {
              "type": "fixed",
              "value": 0
            },
            "interSpawnDist": null
