  "instructions": {
    "showTaskTitleCard": false,
    "showBlockLabel": false,
    "preBlockBeforeBlockIntro": true,
    "skipBeforeBlockScreensOnRepeat": true,
    "introPages": [
      {
        "html": "<div style='font-family: system-ui, -apple-system, sans-serif; font-size: 1.2rem; line-height: 1.45;'>Welcome to the Box Task! Meet Boxy:<p><img src='assets/evander-bricks/sprite/boxy.png' alt='Boxy' style='max-height: 120px; height: 100%; width: auto;'/></p><p>Help Boxy collect as many coins as possible from the boxes in his factory before time runs out!<p>The Goal: Open as many boxes moving along conveyor belts to earn coins.<p>Watch out for Presents - these are worth more coins!<p><img src='assets/evander-bricks/brick_types.png' alt='Present vs Crate example' style='max-width: 300px; width: 100%; height: auto;'/><p>But beware: if any box reaches the furnace at the end of the line, it will get destroyed and you will lose coins.</div>"
      },
      {
        "html": "<div style='font-family: system-ui, -apple-system, sans-serif; font-size: 1.2rem; line-height: 1.45;'>How to Play:<p>To open a box, click the highlighted box to start a short memory task.</p><p>You will see a set of letters, then one probe letter. Press the RIGHT ARROW key if the probe was in the set (YES). Press the LEFT ARROW key if it was not in the set (NO).</p><p><img src='assets/evander-bricks/sprite/boxy_with_box.png' alt='Boxy with box' style='max-height: 120px; height: 100%; width: auto;'/></p><p>Each correct memory response shrinks the highlighted box by one step. Incorrect responses do not shrink the box. Wider boxes require more correct memory tasks before they open.</p><p>The conveyor belts keep moving while you complete the memory task, so respond as accurately and quickly as you can.</p></div>"
      }
    ],
    "blockSummary": {
      "enabled": true,
      "at": "block_end_before_post",
      "when": {
        "isPractice": false
      },
      "title": "End of {blockLabel} of 8",
